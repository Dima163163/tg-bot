@startuml
title C4 — Уровень 3: Компоненты
left to right direction
skinparam componentStyle rectangle
skinparam shadowing false
skinparam wrapWidth 220

actor "Пользователь" as user
package "CustomChat · Node.js process" {
  component "CLI и обработчик строк\nchat.mjs" as cli
  component "OpenAI Adapter\nopenai-adapter.mjs\ngetTextResponse(prompt)" as adapter
  component "Официальный\nOpenAI JavaScript SDK" as sdk

  cli --> adapter : передаёт одну строку
  adapter --> sdk : создаёт обычный\nнепотоковый запрос
}
rectangle "OpenAI Platform\nResponses API и модель" as api

user --> cli : вводит промпт
sdk --> api : запрос с input = prompt
api --> sdk : завершённый ответ
sdk --> adapter : response.output_text
adapter --> cli : Promise<string>
cli --> user : печатает полный ответ
@enduml
