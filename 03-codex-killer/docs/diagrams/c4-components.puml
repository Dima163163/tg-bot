@startuml
title C4 — Уровень 3: Компоненты
left to right direction
skinparam componentStyle rectangle
skinparam shadowing false
skinparam wrapWidth 220

actor "Пользователь" as user
package "CustomChat" {
  package "Node.js process" {
    component "CLI и обработчик строк\nchat.mjs" as cli
    component "Memory Repository\nmemory-repository.mjs\ncreateMemorySession()" as memoryRepo
    component "OpenAI Adapter\nopenai-adapter.mjs\ngetTextResponse(messages)" as adapter
    component "Официальный\nOpenAI JavaScript SDK" as sdk

    cli --> memoryRepo : создаёт сессию\nи сохраняет сообщения
    cli --> adapter : передаёт всю переписку сессии
    adapter --> sdk : создаёт обычный\nнепотоковый запрос
  }
  database "Файлы сессий\nmemory/session-*.json" as memoryFiles
}
rectangle "OpenAI Platform\nResponses API и модель" as api

user --> cli : вводит промпт
memoryRepo --> memoryFiles : атомарно сохраняет JSON
sdk --> api : запрос с input = messages[]
api --> sdk : завершённый ответ
sdk --> adapter : response.output_text
adapter --> cli : Promise<string>
cli --> user : печатает полный ответ
@enduml
