@startuml
title C4 — Уровень 4: Код
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam wrapWidth 220

class ChatModule <<module>> {
  +main(): Promise<void>
  -appendToMemory(session, message): Promise<void>
  -printAssistantReply(text: string): void
}

class MemoryRepository <<module>> {
  +createMemorySession(): Promise<MemorySession>
}

class MemorySession <<object>> {
  +id: string
  +fileName: string
  +messages: ChatMessage[]
  +save(): Promise<void>
}

class ChatMessage <<data>> {
  +role: user | assistant
  +content: string
}

class SessionJsonFile <<file>> {
  +messages: ChatMessage[]
  +createdAt: string
  +updatedAt: string
}

class OpenAIAdapter <<module>> {
  +getTextResponse(messages: ChatMessage[]): Promise<string>
  -getClient(): OpenAIClient
}

class OpenAIClient <<SDK>> {
  +responses: ResponsesClient
}

class ResponsesClient <<SDK>> {
  +create(model: string, input: ChatMessage[]): Promise<Response>
}

class Response {
  +output_text: string
}

ChatModule --> MemoryRepository : createMemorySession() при запуске и /clear
MemoryRepository --> MemorySession : создаёт сессию с пустой перепиской
ChatModule --> MemorySession : добавляет user и assistant сообщения
MemorySession --> SessionJsonFile : save() после каждого сообщения
MemorySession --> ChatMessage : хранит текущий диалог
ChatModule --> OpenAIAdapter : await getTextResponse(session.messages)
OpenAIAdapter --> OpenAIClient : getClient()
OpenAIClient --> ResponsesClient : responses
OpenAIAdapter --> ResponsesClient : create({model, input: messages})
ResponsesClient --> Response : возвращает готовый ответ
Response --> OpenAIAdapter : output_text
OpenAIAdapter --> ChatModule : Promise<string>

note right of MemorySession
  Каждый запуск приложения создаёт
  отдельный memory/session-*.json.
  Старые сессии остаются на диске,
  но в новый диалог не загружаются.
end note
@enduml
