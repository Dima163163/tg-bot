@startuml
title Telegram webhook: ответ по базе статей
autonumber
actor Telegram
participant "Edge + HTTP handler\n(presentation)" as HTTP
participant "authorizeWebhookUseCase" as Auth
participant "handleTelegramUpdateUseCase" as Update
participant "telegramMessageRepository" as Repo
database PostgreSQL as DB
participant "answerKnowledgeQuestionUseCase" as RAG
participant "Groq adapter" as Groq
participant "Supabase AI\ngte-small" as AI
participant "knowledgeSearchRepository" as Search
participant "Telegram Bot API adapter" as Bot

Telegram -> HTTP: POST /functions/v1/webhook/telegram\nсекретный заголовок + update
HTTP -> Auth: execute(secret)
Auth --> HTTP: allowed / denied / unconfigured
alt Неверный путь, метод, секрет, настройки или JSON
  HTTP --> Telegram: 404 / 405 / 401 / 500 / 400
else Запрос принят
  HTTP -> Update: execute(update)
  alt Неподдерживаемый update или отправитель-бот
    Update --> HTTP: Без действий
    HTTP --> Telegram: 200
  else Сообщение пользователя
    Update -> Repo: saveIncoming(message)
    Repo -> DB: RPC save_telegram_message\nupsert клиента + insert сообщения
    DB --> Repo: Сохранено либо входящий дубль пропущен
    Update -> Repo: claim(update_id, attempt_uuid)
    Repo -> DB: RPC claim_telegram_reply\nlease 2 минуты
    DB --> Repo: sent / busy / claimed
    alt sent
      Repo --> Update: Уже отвечено
      Update --> HTTP: Без повторной отправки
      HTTP --> Telegram: 200
    else busy
      Repo --> Update: Попытка уже выполняется
      Update --> HTTP: Ошибка для повтора
      HTTP --> Telegram: 502
    else claimed
      Repo --> Update: Lease получен
      alt /start, /help, нет текста или вопрос слишком длинный
        Update -> Update: Подготовить подсказку без AI
      else Вопрос до 2000 символов
        Update -> RAG: execute(question)
        RAG -> Groq: searchText(question)
        Groq --> RAG: Краткий английский текст
        RAG -> AI: run(text, mean_pool, normalize)
        AI --> RAG: vector(384)
        RAG -> Search: search(vector, model_tag)
        Search -> DB: RPC search_articles\ntop-3, min_similarity=0.5
        DB --> Search: id, title, body, similarity
        Search --> RAG: Подходящие статьи
        alt Есть кандидаты
          RAG -> Groq: answer(question, original_sources)
          Groq --> RAG: JSON answer + source_ids
          RAG -> RAG: Проверить ID и формат\nДобавить названия источников
        else Выдача пуста
          RAG -> RAG: «Мы обрабатываем ваш запрос»
        end
        note right of RAG
          Пустой source_ids от Groq также даёт fallback.
          Ошибка AI: сообщение о временной недоступности.
        end note
        RAG --> Update: Ответ либо fallback
      end
      Update -> Bot: sendMessage(chat_id, text)
      alt Telegram не подтвердил отправку
        Bot --> Update: Ошибка HTTP, сети или JSON ok
        Update -> Repo: fail(update_id, attempt)
        Repo -> DB: RPC fail_telegram_reply
        Update --> HTTP: Ошибка
        HTTP --> Telegram: 502
      else Отправка подтверждена
        Bot --> Update: Фактическая sentAt
        Update -> Repo: complete(update_id, attempt, answer, sentAt)
        Repo -> DB: RPC complete_telegram_reply\nтранзакция: исходящее сообщение + sent
        DB --> Repo: Завершено
        Repo --> Update: Сохранено
        Update --> HTTP: Успешно
        HTTP --> Telegram: 200
      end
    end
  end
end

note over HTTP, DB
  Прямые импорты: presentation -> use case.execute -> repository/adapter.
  DI нет. SQL и PostgREST находятся в репозиториях.
  Ошибки БД приводят к HTTP 502; успешный ответ не подтверждается заранее.
end note
note over Update, Bot
  Обработка синхронная; durable очередь пока не реализована.
  Потеря подтверждения Telegram или сбой БД после отправки могут дать дубль
  после истечения lease. Абсолютная exactly-once доставка не гарантируется.
end note
@enduml
