@startuml
title Telegram webhook: ответ по базе статей
autonumber
actor Telegram
participant "Edge + HTTP handler\n(presentation)" as HTTP
participant "authorizeWebhookUseCase" as Auth
participant "telegramUpdateParser" as Parser
participant "handleTelegramUpdateUseCase" as Update
participant "saveIncomingTelegramMessageUseCase" as Save
participant "sendTelegramReplyUseCase" as Reply
participant "prepareTelegramReplyUseCase" as Prepare
participant "answerConversationUseCase" as Conversation
participant "recentTelegramMessagesRepository" as History
participant "conversations: telegramMessageRepository" as Repo
database PostgreSQL as DB
participant "answerKnowledgeQuestionUseCase" as RAG
participant "Groq adapter" as Groq
participant "Supabase AI\ngte-small" as AI
participant "knowledgeSearchRepository" as Search
participant "Telegram Bot API adapter" as Bot

Telegram -> HTTP: POST /functions/v1/webhook/telegram\nсекретный заголовок + update
HTTP -> Auth: execute(secret)
Auth --> HTTP: allowed / denied / unconfigured
alt Неверный путь, метод, секрет, настройки или JSON
  HTTP --> Telegram: 404 / 405 / 401 / 500 / 400
else Запрос принят
  HTTP -> Parser: parse(update)
  alt Неподдерживаемый update или отправитель-бот
    Parser --> HTTP: null
    HTTP --> Telegram: 200
  else Сообщение пользователя
    Parser --> HTTP: Нормализованные данные
    HTTP -> Update: execute(message)
    Update -> Save: execute(message)
    Save -> Repo: saveIncoming(message)
    Repo -> DB: RPC save_telegram_message\nupsert клиента + insert сообщения
    DB --> Repo: Сохранено либо входящий дубль пропущен
    Repo --> Save: Сохранено
    Save --> Update: Сохранено
    Update -> Reply: execute(message)
    Reply -> Repo: claim(update_id, attempt_uuid)
    Repo -> DB: RPC claim_telegram_reply\nlease 2 минуты
    DB --> Repo: sent / busy / claimed
    alt sent
      Repo --> Reply: Уже отвечено
      Reply --> Update: Без повторной отправки
      Update --> HTTP: Без повторной отправки
      HTTP --> Telegram: 200
    else busy
      Repo --> Reply: Попытка уже выполняется
      Reply --> Update: Ошибка для повтора
      Update --> HTTP: Ошибка для повтора
      HTTP --> Telegram: 502
    else claimed
      Repo --> Reply: Lease получен
      Reply -> Prepare: execute(body)
      alt /start, /help, нет текста или вопрос слишком длинный
        Prepare -> Prepare: Подготовить подсказку без AI
      else Вопрос до 2000 символов
        Prepare -> RAG: execute(question)
        RAG -> Groq: searchText(question)
        Groq --> RAG: Краткий английский текст
        RAG -> AI: run(text, mean_pool, normalize)
        AI --> RAG: vector(384)
        RAG -> Search: search(vector, model_tag)
        Search -> DB: RPC search_articles\ntop-3, min_similarity=0.5
        DB --> Search: id, title, body, similarity
        Search --> RAG: Подходящие статьи
        alt Есть кандидаты
          RAG -> Groq: answer(question, original_sources)
          Groq --> RAG: JSON answer + source_ids
          RAG -> RAG: Проверить ID и формат\nДобавить названия источников
        else Выдача пуста
          RAG -> RAG: «Мы обрабатываем ваш запрос»
        end
        note right of RAG
          Пустой source_ids от Groq также включает fallback.
          Ошибка поиска: сообщение о временной недоступности;
          при 429 бот просит вернуться позже.
        end note
        RAG --> Prepare: Ответ и источники либо пустой список
        alt Ответ по статьям не найден
          Prepare -> Conversation: execute(update_id, user_id, question)
          Conversation -> History: findForUpdate(...)
          History -> DB: Найти текущее сообщение пользователя\nи до 5 последних сообщений его клиента
          alt Ошибка чтения истории
            DB --> History: Ошибка
            Conversation --> Prepare: Ошибка
            Prepare -> Prepare: Сообщение о временной недоступности
          else История прочитана
            DB --> History: Сообщения
            History --> Conversation: До 5 сообщений, включая вопрос
            Conversation -> Groq: Диалоговый ответ с историей
            alt Лимит Groq исчерпан (429)
              Groq --> Conversation: Ограничение
              Conversation --> Prepare: RATE_LIMIT
              Prepare -> Prepare: «Вернитесь с вашим вопросом позже»
            else Другая ошибка AI
              Groq --> Conversation: Ошибка
              Conversation --> Prepare: Ошибка
              Prepare -> Prepare: Сообщение о временной недоступности
            else Ответ получен
              Groq --> Conversation: Ответ
              Conversation --> Prepare: Ответ
            end
          end
        end
      end
      Prepare --> Reply: Текст ответа
      Reply -> Bot: sendMessage(chat_id, text)
      alt Telegram не подтвердил отправку
        Bot --> Reply: Ошибка HTTP, сети или JSON ok
        Reply -> Repo: fail(update_id, attempt)
        Repo -> DB: RPC fail_telegram_reply
        Reply --> Update: Ошибка
        Update --> HTTP: Ошибка
        HTTP --> Telegram: 502
      else Отправка подтверждена
        Bot --> Reply: Фактическая sentAt
        Reply -> Repo: complete(update_id, attempt, answer, sentAt)
        Repo -> DB: RPC complete_telegram_reply\nтранзакция: исходящее сообщение + sent
        DB --> Repo: Завершено
        Repo --> Reply: Сохранено
        Reply --> Update: Сохранено
        Update --> HTTP: Успешно
        HTTP --> Telegram: 200
      end
    end
  end
end

note over HTTP, DB
  Прямые импорты: presentation -> use case.execute -> repository/adapter.
  DI нет. SQL и PostgREST находятся в репозиториях.
  Ошибки БД приводят к HTTP 502; успешный ответ не подтверждается заранее.
end note
note over Update, Bot
  Обработка синхронная; durable очередь пока не реализована.
  Потеря подтверждения Telegram или сбой БД после отправки могут дать дубль
  после истечения lease. Абсолютная exactly-once доставка не гарантируется.
end note
@enduml
