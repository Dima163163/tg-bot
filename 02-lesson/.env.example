# Telegram bot token. Keep the real value only in .env or Supabase Secrets.
BOT_TOKEN=

# Shared secret sent by Telegram in X-Telegram-Bot-Api-Secret-Token.
TELEGRAM_WEBHOOK_SECRET=

# Public Supabase project URL used by Realtime and the local auth API.
VITE_SUPABASE_URL=https://cappgvetnxvjhnxufhkz.supabase.co

# Public key for browser Realtime and server-side Auth/Edge Function requests.
# Prefer the project's publishable key; the legacy anon key remains supported.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YGdZYdEx5xU4NMs8Axgw9Q__a3Cyo7z

# Base64-encoded 32-byte key for encrypting the HttpOnly session cookie.
# Generate locally with: openssl rand -base64 32
# If omitted during local development, a temporary key is generated on startup.
AUTH_COOKIE_SECRET=

# Set to true when the panel is served over HTTPS.
AUTH_COOKIE_SECURE=false
