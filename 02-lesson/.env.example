# Telegram bot token. Keep the real value only in .env or Supabase Secrets.
BOT_TOKEN=

# Shared secret sent by Telegram in X-Telegram-Bot-Api-Secret-Token.
TELEGRAM_WEBHOOK_SECRET=

# Public Supabase project URL used by Realtime and the local auth API.
VITE_SUPABASE_URL=https://cappgvetnxvjhnxufhkz.supabase.co

# Public key for browser Realtime and server-side Auth/Edge Function requests.
# Prefer the project's publishable key; the legacy anon key remains supported.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YGdZYdEx5xU4NMs8Axgw9Q__a3Cyo7z

# Base64-encoded 32-byte key for encrypting the HttpOnly session cookie.
# Generate locally with: openssl rand -base64 32
# If omitted during local development, a temporary key is generated on startup.
AUTH_COOKIE_SECRET=

# Set to true when the panel is served over HTTPS.
AUTH_COOKIE_SECURE=false

# Active RAG: native Supabase gte-small(384) with Groq English search projection.
# GROQ_API_KEY is server-only; configure it in Supabase Secrets.
EMBEDDINGS_PROVIDER=supabase-groq
GROQ_MODEL=openai/gpt-oss-20b
GROQ_API_KEY=
RAG_MIN_SIMILARITY=0.5

# Local MCP calls this protected Edge endpoint to compute embeddings.
# Use a random server secret; never use a VITE_ prefix for either API key/token.
RAG_ADMIN_URL=https://cappgvetnxvjhnxufhkz.supabase.co/functions/v1/knowledge-admin
RAG_ADMIN_TOKEN=

# Alternative external embeddings provider, used only when EMBEDDINGS_PROVIDER
# is empty. It must output 384 dimensions; changing provider requires reindexing
# articles and updating the query embedding adapter as well.
EMBEDDINGS_API_URL=
EMBEDDINGS_MODEL=
EMBEDDINGS_API_KEY=
# Some models require a prefix; preserve its trailing space with quotes locally.
EMBEDDINGS_DOCUMENT_PREFIX=
