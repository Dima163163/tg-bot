# Telegram bot token. Keep the real value only in .env or Supabase Secrets.
BOT_TOKEN=

# Shared secret sent by Telegram in X-Telegram-Bot-Api-Secret-Token.
TELEGRAM_WEBHOOK_SECRET=

# Public Supabase project URL used by the browser to call Edge Functions.
VITE_SUPABASE_URL=https://cappgvetnxvjhnxufhkz.supabase.co

# Public browser key for Supabase Realtime and Edge Function requests.
# Prefer the project's publishable key; the legacy anon key remains supported.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YGdZYdEx5xU4NMs8Axgw9Q__a3Cyo7z
