# Telegram bot token. Keep the real value only in .env or Supabase Secrets.
BOT_TOKEN=

# Shared secret sent by Telegram in X-Telegram-Bot-Api-Secret-Token.
TELEGRAM_WEBHOOK_SECRET=

# Public Supabase project URL used by the browser to call Edge Functions.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Optional publishable/anon key. Edge Functions are configured with auth: none,
# but providing the key keeps requests compatible with Supabase gateways.
VITE_SUPABASE_ANON_KEY=
